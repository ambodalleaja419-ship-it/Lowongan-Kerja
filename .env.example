# GEMINI_API_KEY: Required for Gemini AI API calls (injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Supabase Configuration (Frontend & Backend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server Only Credentials (Do NOT expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
ADMIN_TELEGRAM_CHAT_ID="your-telegram-chat-id"
